[packages]
fastapi = "*"
uvicorn = "*"
pydantic = "*"
pydantic-settings = "*"
# messaging/aisensy.py posts with this, and starlette's test client picks it
# over httpx when both are present - so the connector and the app under test
# share one transport rather than differing by a major version.
httpx2 = "*"
langchain = "*"
langchain-ollama = "*"
ollama = "*"
faster-whisper = "*"
piper-tts = "*"
torch = {version = "*", index = "downloadpytorch"}
torchvision = {version = "*", index = "downloadpytorch"}
torchaudio = {version = "*", index = "downloadpytorch-260"}

[dev-packages]
pytest = "*"

[requires]
python_version = "3.14"
python_full_version = "3.14.6"
