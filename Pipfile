[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = "*"
pydantic = "*"
pydantic-settings = "*"
httpx2 = "*"
# messaging/aisensy.py imports httpx directly. It currently arrives as a
# transitive dependency of ollama, which would make the AiSensy connector
# break on a dependency bump it has nothing to do with.
httpx = "*"
langchain = "*"
langchain-ollama = "*"
ollama = "*"

[dev-packages]
pytest = "*"

[requires]
python_version = "3.14"
python_full_version = "3.14.6"
