# Copy to .env and edit. .env is gitignored; this file is not, so never put a
# real secret here.
#
#   cp .env.example .env
#
# A variable already set in the real environment always wins over this file:
# it is a default for local development, not an override of what an operator
# deliberately exported.

# ----------------------------------------------------------------- voice
# Browser push-to-talk: local Whisper in, local Piper/MMS out. Needs the
# models on disk first - run: python scripts/setup_voice.py
VOICE_ENABLED=1

# tiny | base | small | medium | large-v3. "small" is the sweet spot on a
# 6 GB laptop GPU: 0.28 s for 6.9 s of audio.
WHISPER_MODEL=small
# cuda or cpu. On CPU a turn takes seconds and stops being a conversation.
WHISPER_DEVICE=cuda
PIPER_VOICE_DIR=models/piper

# ----------------------------------------------------------------- clinic
CLINIC_NAME=Al Noor Dental
REVIEW_LINK=https://g.page/r/alnoor-dental/review
# Bolna timestamps arrive UTC; "tomorrow at 3pm" is meant in clinic local
# time. 4 is UAE.
CLINIC_UTC_OFFSET_HOURS=4

# ----------------------------------------------------------------- messaging
# aisensy | telegram | empty to auto-detect from whichever credential is set.
MESSAGING_PROVIDER=

# Free of charge, unlike WhatsApp - but Telegram addresses a chat_id, not a
# phone number, so a patient must message the bot before they can be reached.
# TELEGRAM_BOT_TOKEN=

# WhatsApp via AiSensy. Meta bills per template message.
# AISENSY_API_KEY=
AISENSY_BASE_URL=https://backend.aisensy.com

# ----------------------------------------------------------------- telephony
# Bolna signs nothing, so this shared secret is the only thing separating a
# real delivery from anyone who guesses the URL. An unset value makes the
# webhook refuse every request rather than accept unauthenticated bookings.
# BOLNA_WEBHOOK_SECRET=
# Additive to Bolna's documented egress address. Put n8n's egress IP here if
# n8n fronts the webhook, or 127.0.0.1 to test locally with curl.
# BOLNA_EXTRA_SOURCE_IPS=127.0.0.1

# ----------------------------------------------------------------- LLM
# Second-opinion slot extractor. Measured on this corpus it rescues nothing
# and adds one or two unnecessary read-backs, so it is off by default - see
# the table in the README.
LLM_CROSSCHECK_ENABLED=
LLM_MODEL=gpt-oss:120b-cloud
LLM_BASE_URL=http://localhost:11434

# ----------------------------------------------------------------- ASR (post-call)
# Re-transcribe the Bolna recording for per-word confidence. Needs a NeMo
# checkpoint; unrelated to the browser voice loop above.
ASR_ENABLED=
ASR_MODEL=ai4bharat/indic-conformer-600m-multilingual
