# ==========================================================================
#  Clinic Voice Receptionist — configuration
# ==========================================================================
#
#     cp .env.example .env
#
# .env is gitignored; this file is not, so it must never hold a real secret.
# A variable already set in the real environment always wins over the file:
# it is a default for local development, not an override of what an operator
# deliberately exported.
#
# Nothing here is required. Every value below is the built-in default, so an
# empty .env behaves exactly like no .env at all, and the system answers in
# text with no configuration.
#
# A test fails if the code reads a setting this file does not mention, so
# this list cannot drift out of date.


# ==========================================================================
#  1. THE CLINIC — hours, capacity, identity
# ==========================================================================
CLINIC_NAME=Al Noor Dental
REVIEW_LINK=https://g.page/r/alnoor-dental/review

# Bolna timestamps arrive in UTC and "tomorrow at 3pm" is meant in clinic
# local time. 4 is UAE. Wrong, and every evening caller is booked a day out.
CLINIC_UTC_OFFSET_HOURS=4

# Opening hours, HH:MM. These are spoken to callers, not just enforced.
CLINIC_OPEN_TIME=09:00
CLINIC_CLOSE_TIME=20:00

# Days the clinic is shut. Monday=0 … Sunday=6, comma separated.
# 4 is Friday, the UAE weekend anchor.
CLINIC_CLOSED_WEEKDAYS=4

# Nothing is booked across this break.
CLINIC_LUNCH_START=13:00
CLINIC_LUNCH_END=14:00

# Appointments start on these boundaries, in minutes.
CLINIC_SLOT_GRANULARITY_MIN=15

# How many patients can be treated at once. Drives the booking conflict
# check, so it is the difference between "fully booked" and a double-booked
# chair.
CLINIC_CHAIRS=2


# ==========================================================================
#  2. THE SAFETY GATE — when the agent reads a value back
# ==========================================================================
# Below these confidences a value is read back to the caller instead of
# booked on. This is the safety policy of the whole system.
#
# Phone is highest because one wrong digit is still a valid number, so
# nothing downstream can catch the error. Procedure is lowest because it is
# drawn from a closed set, where a near-miss still lands on a real value.
#
# Raising these means more read-backs and fewer silent errors; lowering them
# is the opposite trade, and is how a wrong appointment reaches a patient.
THRESHOLD_PHONE=0.92
THRESHOLD_APPOINTMENT_TIME=0.85
THRESHOLD_PATIENT_NAME=0.75
THRESHOLD_PROCEDURE=0.70


# ==========================================================================
#  3. THE CONVERSATION — when to give up and fetch a human
# ==========================================================================
# How many times one field may be asked for, each time worded differently,
# before handing off. A caller who did not understand a sentence will not
# understand the same sentence.
MAX_ASKS_PER_SLOT=3

# Consecutive turns that add no new detail before escalating. Progress, not
# elapsed turns: a caller steadily supplying details should never run out.
MAX_TURNS_WITHOUT_PROGRESS=4

# Failed or ambiguous answers to a read-back before handing off. An unclear
# answer is never treated as a yes.
MAX_READBACK_FAILURES=2


# ==========================================================================
#  4. VOICE — browser push-to-talk
# ==========================================================================
# Whisper in, Piper/MMS out, all on this machine. Fetch the models first:
#     python scripts/setup_voice.py
VOICE_ENABLED=1

# tiny | base | small | medium | large-v3
# "small" is the sweet spot on a 6 GB laptop GPU: 0.28 s for 6.9 s of audio.
WHISPER_MODEL=small

# cuda or cpu. On CPU a turn takes seconds and stops being a conversation.
WHISPER_DEVICE=cuda

# float16 on a GPU, int8 on CPU. Mismatched, it either refuses to load or
# runs far slower than it should.
WHISPER_COMPUTE_TYPE=float16

PIPER_VOICE_DIR=models/piper

# MMS covers Tamil and Kannada, which Piper has no voice for at all. Separate
# from WHISPER_DEVICE so the two can be split when VRAM is tight — worth
# setting to cpu if the GPU is already shared with a browser.
TTS_DEVICE=cuda


# ==========================================================================
#  5. UNDERSTANDING — what the caller meant
# ==========================================================================
# The model reads the utterance and fills the slots; the rule extractor is
# the fallback when it is unreachable. This is what lets the agent cope with
# "Amna Ansari" as a bare answer, with a described symptom, and with
# code-switched speech — none of which a regex handles without being told.
#
# Confidence is NOT taken from the model. It says what was said; the ASR word
# confidences say how sure we are it was heard, and the gate above uses
# those. A model is most confident exactly when it is fluently wrong.
LLM_EXTRACTION_ENABLED=1

# gpt-oss:120b-cloud measures ~2.8 s per turn and is accurate. A local 4B on
# a 6 GB GPU already shared with Whisper is far slower.
LLM_EXTRACTION_MODEL=gpt-oss:120b-cloud

# REQUIRED for any "-cloud" tag or non-localhost host. A transcript is a
# patient's name, number and medical complaint in one sentence, so sending it
# to someone else's hardware is a decision, not a default — the code raises
# rather than let it happen quietly.
#
# Note a cloud model is served *through* localhost, so the URL looks local
# while the inference is not. The check reads the model tag, not the URL.
LLM_ALLOW_REMOTE=1

LLM_BASE_URL=http://localhost:11434

# Context window. The single biggest latency factor for a local model:
# Ollama defaults qwen3 to 131072, which inflates a 2.5 GB model to 23 GB and
# offloads most of it to the CPU. A system prompt and one utterance fit in
# 2048 with room to spare.
LLM_NUM_CTX=2048

# A four-field object is small; the cap stops a rambling model holding the
# turn hostage.
LLM_NUM_PREDICT=256

# Keep the model resident between turns. Reloading it per utterance would
# dominate the latency budget.
LLM_KEEP_ALIVE=30m

LLM_TIMEOUT_S=30


# ==========================================================================
#  6. MESSAGING — confirmation, reminder, review request
# ==========================================================================
# aisensy | telegram | empty to auto-detect from whichever credential is set.
# Empty with no credentials uses the mock, which builds the real request body
# without sending — so an ordering or template mistake still fails loudly.
MESSAGING_PROVIDER=

# Free of charge, unlike WhatsApp — but Telegram addresses a chat_id, not a
# phone number, so a patient who has not messaged the bot is unreachable.
# TELEGRAM_BOT_TOKEN=

# WhatsApp via AiSensy. Meta bills per template message from the first send.
# AISENSY_API_KEY=
AISENSY_BASE_URL=https://backend.aisensy.com


# ==========================================================================
#  7. TELEPHONY — the Bolna post-call webhook
# ==========================================================================
# Bolna signs nothing, so this shared secret is the only thing separating a
# real delivery from anyone who guesses the URL. Unset, the webhook refuses
# every request rather than accepting unauthenticated bookings.
# BOLNA_WEBHOOK_SECRET=

# Additive to Bolna's documented egress address. Put n8n's egress IP here if
# n8n fronts the webhook, or 127.0.0.1 to test locally with curl.
# BOLNA_EXTRA_SOURCE_IPS=127.0.0.1


# ==========================================================================
#  8. OFF BY DEFAULT — measured, and not currently worth it
# ==========================================================================
# Second-opinion cross-check. Different from the extractor in section 5: it
# can only ever LOWER confidence on disagreement and can never set a value.
# Measured on this corpus it rescues nothing, adds one or two unnecessary
# read-backs, and costs an extra model call per turn. Table in the README.
LLM_CROSSCHECK_ENABLED=
LLM_MODEL=gpt-oss:120b-cloud

# Re-transcribe the Bolna call recording for per-word confidence. Needs a
# NeMo checkpoint, and every AI4Bharat repository is gated on Hugging Face.
# Unrelated to VOICE_ENABLED in section 4.
ASR_ENABLED=
ASR_MODEL=ai4bharat/indic-conformer-600m-multilingual


# ==========================================================================
#  9. HOUSEKEEPING
# ==========================================================================
# Quietens the Windows symlink warning from the Hugging Face cache.
HF_HUB_DISABLE_SYMLINKS_WARNING=1
